{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sundt.example/schemas/powerbi-alation-contract.schema.json",
  "title": "Power BI Alation Data Contract",
  "type": "object",
  "required": ["contractVersion", "contractStatus", "product", "assets", "metrics", "relationships", "review"],
  "properties": {
    "contractVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contractStatus": {"enum": ["draft", "submitted", "validated", "steward_approved", "published", "retired"]},
    "product": {
      "type": "object",
      "required": ["productId", "name", "description"],
      "properties": {
        "productId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "businessContext": {"type": "string"},
        "exampleQuestions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "required": ["reports", "semanticModels"],
      "properties": {
        "reports": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "semanticModels": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "review": {
      "type": "object",
      "required": ["owner", "steward", "certificationStatus"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "steward": {"type": "string", "minLength": 1},
        "certificationStatus": {"enum": ["unreviewed", "in_review", "approved", "rejected", "exception"]},
        "lastReviewed": {"type": ["string", "null"]},
        "knownLimitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["name", "alationId"],
      "properties": {
        "name": {"type": "string"},
        "alationId": {"type": ["integer", "string"]},
        "externalId": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]},
        "parentDatasourceExternalId": {"type": ["string", "null"]}
      }
    },
    "metric": {
      "type": "object",
      "required": ["metricId", "displayName", "modelTable", "role", "expressionLanguage", "daxExpression", "grain", "aggregationRule", "lineage", "usage", "review"],
      "properties": {
        "metricId": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "definition": {"type": "string"},
        "modelTable": {"type": "string", "minLength": 1},
        "role": {"enum": ["base_value", "score", "weighted_score", "display", "status", "color", "arrow", "html", "trend"]},
        "expressionLanguage": {"const": "DAX"},
        "daxExpression": {"type": "string", "minLength": 1},
        "formatString": {"type": "string"},
        "grain": {"type": "string", "minLength": 1},
        "aggregationRule": {"type": "string", "minLength": 1},
        "directDependencies": {"type": "array", "items": {"type": "string"}},
        "transitiveDependencies": {"type": "array", "items": {"type": "string"}},
        "lineage": {"$ref": "#/$defs/lineage"},
        "usage": {"$ref": "#/$defs/usage"},
        "glossaryTerms": {"type": "array", "items": {"type": "string"}},
        "review": {"$ref": "#/$defs/metricReview"}
      }
    },
    "lineage": {
      "type": "object",
      "required": ["sourcePaths", "status"],
      "properties": {
        "sourcePaths": {"type": "array", "items": {"type": "string"}},
        "alationObjectIds": {"type": "array", "items": {"type": ["integer", "string"]}},
        "status": {"enum": ["matched", "partial", "unresolved", "model_only"]}
      }
    },
    "usage": {
      "type": "object",
      "required": ["referenceCount", "visuals"],
      "properties": {
        "referenceCount": {"type": "integer", "minimum": 0},
        "visuals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metricReview": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unreviewed", "in_review", "approved", "rejected", "exception"]},
        "notes": {"type": "string"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["name", "leftTable", "rightTable", "expression", "cardinality"],
      "properties": {
        "name": {"type": "string"},
        "leftTable": {"type": "string"},
        "rightTable": {"type": "string"},
        "expression": {"type": "string"},
        "cardinality": {"type": "string"},
        "leftNullable": {"type": "boolean"},
        "rightNullable": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
